{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pharmacy-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "JsonStore": {
    "DataDirectory": "data"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173"
    ],
    "CsrfCookieName": "pharmacy.csrf",
    "CsrfHeaderName": "X-CSRF-TOKEN"
  },
  "ApiKey": {
    "Value": "pharmacy-demo-api-key-8f3c2a1b",
    "CookieName": "pharmacy.apikey"
  },
  "DemoAuth": {
    "Username": "admin",
    "Password": "Admin@123"
  }
}
